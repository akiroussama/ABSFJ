{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "cleanUrls": false,
  "functions": {
    "api/photos.js": { "maxDuration": 30 },
    "api/publications.js": { "maxDuration": 30, "includeFiles": "assets/data/publications-legacy.json" },
    "api/publication-photos.js": { "maxDuration": 30, "includeFiles": "assets/data/publications-legacy.json" },
    "api/bureau.js": { "maxDuration": 30, "includeFiles": "assets/data/publications-legacy.json" }
  },
  "rewrites": [
    { "source": "/bureau-publications", "destination": "/bureau-publications.html" },
    { "source": "/guide-bureau.pdf", "destination": "/assets/guides/guide-bureau.pdf" }
  ],
  "headers": [
    {
      "source": "/guide-bureau.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline; filename=Guide-utilisateur-ABSFJ.pdf" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/guides/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/bureau-publications(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
